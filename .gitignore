# Project-specific working docs (generated per-project, not shipped)
docs/

# Eval suites are tracked: without them skill performance cannot be measured, and
# an untracked suite silently rots against the skill it grades. This repo is public,
# so every task/fixture must stay free of company-specific identifiers -- ticket
# keys, internal hosts, repo names, Slack channel IDs, real names. Run the eval
# identifier scan in CLAUDE.md before committing. Run artifacts never ship.
evals/**/results/

# waza run artifacts (paths.results in .waza.yaml). Probe/right/wrong JSONs are
# regenerated by tools/eval-fixture.py; the durable input is evals/<skill>/validation.yaml.
results/

# Local config (contains company-specific URLs and page IDs)
confluence.local.md
*.local.md
skills/*/settings.local.md

# Local scratch (claude-mem context dump, slide outputs)
AGENTS.md
outputs/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# MCP / tool local state
.serena/

# Waza artifacts nested inside skills (waza init duplicate)
# NOTE: skills/*/README.md is intentionally tracked (per-skill human guide) — not ignored.
skills/*/.github/
skills/*/.gitignore
skills/*/.waza.yaml
skills/*/evals/
skills/*/skills/
__pycache__/

# Browser-MCP scratch artifacts (snapshots, console logs, downloads).
.playwright-mcp/

# superpowers 잔재 (플러그인 비활성화됨, 과거 SDD 산출물)
.superpowers/
