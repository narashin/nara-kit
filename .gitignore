# Project-specific working docs (generated per-project, not shipped)
docs/

# Eval suites stay untracked by default: several carry internal hostnames, ticket
# keys and queue structure, and this repo is public. Opt a suite in only after its
# tasks/fixtures are free of company-specific identifiers. Run artifacts never ship.
evals/*
!evals/nara-code-review/
evals/**/results/

# Local config (contains company-specific URLs and page IDs)
confluence.local.md
*.local.md
skills/*/settings.local.md

# Local scratch (claude-mem context dump, slide outputs)
AGENTS.md
outputs/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# MCP / tool local state
.serena/

# Waza artifacts nested inside skills (waza init duplicate)
# NOTE: skills/*/README.md is intentionally tracked (per-skill human guide) — not ignored.
skills/*/.github/
skills/*/.gitignore
skills/*/.waza.yaml
skills/*/evals/
skills/*/skills/
__pycache__/

# Browser-MCP scratch artifacts (snapshots, console logs, downloads).
.playwright-mcp/

# superpowers 잔재 (플러그인 비활성화됨, 과거 SDD 산출물)
.superpowers/
