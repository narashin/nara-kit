index 0000000..5d6e7f8
--- /dev/null
+++ b/tests/components/teams/TeamRow.test.tsx
@@ -0,0 +1,52 @@
+import { render } from "@testing-library/react";
+
+import { TeamRow, VISIBLE_TAG_COUNT } from "../../../components/teams/TeamRow";
+
+const baseRow = { id: "r1", ownerName: "Alan Park", tags: ["a", "b"] };
+
+describe("TeamRow", () => {
+  it("does not leak null into the owner cell", () => {
+    // ownerName 가드가 없으면 셀에 "null"이 찍힌다
+    const { getAllByRole } = render(
+      <TeamRow rows={[{ ...baseRow, ownerName: null }]} requesterRole="OWNER" emptyState={null} />,
+    );
+    expect(getAllByRole("cell")[0]).not.toHaveTextContent("null");
+  });
+
+  it("shows the empty state instead of a table", () => {
+    const { queryByRole } = render(
+      <TeamRow rows={[]} requesterRole="OWNER" emptyState={<p>No teams found</p>} />,
+    );
+    expect(queryByRole("table")).not.toBeInTheDocument();
+  });
+
+  it("caps the visible tags and shows an overflow badge", () => {
+    const { getByText } = render(
+      <TeamRow
+        rows={[{ ...baseRow, tags: ["a", "b", "c", "d", "e"] }]}
+        requesterRole="OWNER"
+        emptyState={null}
+      />,
+    );
+    expect(getByText(`+${5 - VISIBLE_TAG_COUNT}`)).toBeInTheDocument();
+    expect(getByText(/a, b/)).toBeInTheDocument();
+  });
+
+  it.each(["OWNER", "MEMBER", "VIEWER", "ADMIN", "GUEST"] as const)(
+    "renders for the %s role",
+    (requesterRole) => {
+      const { getByRole } = render(
+        <TeamRow rows={[baseRow]} requesterRole={requesterRole} emptyState={null} />,
+      );
+      expect(getByRole("table")).toBeInTheDocument();
+    },
+  );
+});
