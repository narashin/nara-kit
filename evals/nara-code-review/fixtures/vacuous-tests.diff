@@ -0,0 +1,34 @@
+import type { ReactNode } from "react";
+
+export const VISIBLE_TAG_COUNT = 2;
+
+type Row = { id: string; ownerName: string | null; tags: string[] };
+type Props = {
+  rows: Row[];
+  requesterRole: "OWNER" | "MEMBER" | "VIEWER" | "ADMIN" | "GUEST";
+  emptyState: ReactNode;
+};
+
+export function TeamRow({ rows, emptyState }: Props) {
+  if (!rows.length) return <>{emptyState}</>;
+
+  return (
+    <table>
+      <tbody>
+        {rows.map((row) => (
+          <tr key={row.id}>
+            <td>{row.ownerName && <span>{row.ownerName}</span>}</td>
+            <td>
+              {row.tags.slice(0, VISIBLE_TAG_COUNT).join(", ")}
+              {row.tags.length > VISIBLE_TAG_COUNT && (
+                <span>{`+${row.tags.length - VISIBLE_TAG_COUNT}`}</span>
+              )}
+            </td>
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
diff --git a/tests/components/teams/TeamRow.test.tsx b/tests/components/teams/TeamRow.test.tsx
